{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextcourse.dev/schemas/case.v1.schema.json",
  "title": "NextCourse reusable teaching case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "title", "input", "task", "expectedOutput", "materials", "answerMaterial", "rubricMaterial"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/caseId" },
    "version": { "$ref": "#/$defs/version" },
    "title": { "type": "string", "minLength": 1 },
    "input": { "type": "string", "minLength": 1 },
    "task": { "type": "string", "minLength": 1 },
    "expectedOutput": { "type": "string", "minLength": 1 },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "path", "role", "audience"],
        "properties": {
          "id": { "$ref": "#/$defs/localId" },
          "title": { "type": "string", "minLength": 1 },
          "path": { "$ref": "#/$defs/relativePath" },
          "role": { "enum": ["input", "worksheet", "reference", "answer", "rubric"] },
          "audience": { "enum": ["student", "facilitator", "both"] },
          "dependencies": {
            "type": "array",
            "items": { "$ref": "#/$defs/relativePath" },
            "uniqueItems": true
          }
        }
      }
    },
    "answerMaterial": { "$ref": "#/$defs/localId" },
    "rubricMaterial": { "$ref": "#/$defs/localId" },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "parameters", "seed", "outputs"],
      "properties": {
        "script": { "$ref": "#/$defs/relativePath" },
        "parameters": { "type": "object" },
        "seed": { "type": ["string", "number"] },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "hash"],
            "properties": {
              "path": { "$ref": "#/$defs/relativePath" },
              "hash": { "$ref": "#/$defs/hash" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "localId": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$" },
    "caseId": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?:case:[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" }
  }
}
