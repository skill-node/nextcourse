{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextcourse.dev/schemas/sequence.v1.schema.json",
  "title": "NextCourse reusable teaching sequence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "title", "items"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/sequenceId" },
    "version": { "$ref": "#/$defs/version" },
    "title": { "type": "string", "minLength": 1 },
    "durationMinutes": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref"],
        "properties": {
          "id": { "$ref": "#/$defs/localId" },
          "ref": { "$ref": "#/$defs/contentId" },
          "plannedMinutes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "part": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$" },
    "localId": { "$ref": "#/$defs/part" },
    "sequenceId": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?:sequence:[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$" },
    "contentId": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?:(unit|page):[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" }
  }
}
