{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextcourse.dev/schemas/course.lock.v1.schema.json",
  "title": "NextCourse resolved composition lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "courseId", "recipeId", "engineVersion", "composeHash", "sourceManifestHash", "references"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "courseId": { "$ref": "#/$defs/localId" },
    "recipeId": { "$ref": "#/$defs/localId" },
    "engineVersion": { "$ref": "#/$defs/version" },
    "composeHash": { "$ref": "#/$defs/hash" },
    "sourceManifestHash": { "$ref": "#/$defs/hash" },
    "references": {
      "type": "array",
      "items": { "$ref": "#/$defs/reference" }
    }
  },
  "$defs": {
    "localId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
    },
    "entityId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?:(unit|sequence|page|case|asset):[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occurrenceId", "ref", "version", "contentHash", "snapshotPath", "sourcePath", "exportPath", "dependencyPath"],
      "properties": {
        "occurrenceId": { "$ref": "#/$defs/localId" },
        "ref": { "$ref": "#/$defs/entityId" },
        "version": { "$ref": "#/$defs/version" },
        "contentHash": { "$ref": "#/$defs/hash" },
        "snapshotPath": { "$ref": "#/$defs/relativePath" },
        "sourcePath": { "$ref": "#/$defs/relativePath" },
        "exportPath": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/entityId" }
        },
        "dependencyPath": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/entityId" }
        },
        "assets": { "type": "array", "items": { "$ref": "#/$defs/entityId" }, "uniqueItems": true },
        "cases": { "type": "array", "items": { "$ref": "#/$defs/entityId" }, "uniqueItems": true },
        "deliveryFiles": { "type": "array", "items": { "$ref": "#/$defs/relativePath" }, "uniqueItems": true },
        "sourceRevision": { "type": "string" }
      }
    }
  }
}
